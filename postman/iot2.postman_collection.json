                  "pm.test(\"Устройство связано с пользователем\", () => pm.expect(pm.response.json().users_devices.length).to.eql(1));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "11 Получить тестовые письма Mailpit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8025/api/v1/messages",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        }
      ]
    },
