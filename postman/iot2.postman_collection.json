{
  "info": {
    "name": "IoT2 — ручная проверка",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Выполняйте папку 01 вручную: после первого запроса откройте telegram_url и подтвердите Telegram в боте. Затем проверьте подтверждение, задайте пароль и войдите. ID и токен сохраняются в локальных переменных. Папка 02 содержит дополнительные действия, папка 03 удаляет только тестовые сущности. HTTPS certificate verification отключена для локальных запросов."
  },
  "variable": [
    {
      "key": "iot2_core",
      "value": "https://localhost:8443"
    },
    {
      "key": "iot2_adapter",
      "value": "http://localhost:8081"
    },
    {
      "key": "iot2_user_id",
      "value": ""
    },
    {
      "key": "iot2_device_id",
      "value": ""
    },
    {
      "key": "iot2_rule_id",
      "value": ""
    },
    {
      "key": "iot2_test_mail",
      "value": ""
    },
    {
      "key": "iot2_test_password",
      "value": ""
    },
    {
      "key": "iot2_token",
      "value": ""
    },
    {
      "key": "iot2_registration_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Полный цикл — выполнить по порядку",
      "item": [
        {
          "name": "01 Ввести почту и получить ссылку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_core}}/auth/register/start",
            "description": "После ответа откройте значение telegram_url в Telegram и нажмите «Старт».",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{iot2_test_mail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set(\"iot2_test_mail\", \"postman-\" + stamp + \"@example.com\");",
                  "pm.collectionVariables.set(\"iot2_test_password\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"iot2_registration_token\", pm.response.json().registration_token);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "02 Проверить подтверждение Telegram",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_registration_token}}"
              }
            ],
            "url": "{{iot2_core}}/auth/register/status",
            "description": "Выполните после нажатия «Старт» в личном чате. Дождитесь telegram_confirmed: true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Telegram подтверждён\", () => pm.expect(pm.response.json().telegram_confirmed).to.be.true);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "03 Задать пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_registration_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_core}}/users",
            "description": "Завершите регистрацию до истечения срока ссылки.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{iot2_test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"iot2_user_id\", pm.response.json().id);",
                  "  pm.collectionVariables.unset(\"iot2_registration_token\");",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "Войти и сохранить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_core}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{iot2_test_mail}}\",\n  \"password\": \"{{iot2_test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const session = pm.response.json();",
                  "    pm.collectionVariables.set(\"iot2_token\", session.token);",
                  "    pm.collectionVariables.set(\"iot2_user_id\", session.user_id);",
                  "} else {",
                  "    pm.collectionVariables.unset(\"iot2_token\");",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "02 Создать устройство",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/devices",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman IoT2 Sensor\",\n  \"notifications_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"iot2_device_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "03 Создать правило temperature > 30",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/rules",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{iot2_device_id}},\n  \"field\": \"temperature\",\n  \"operator\": \"gt\",\n  \"threshold\": 30,\n  \"message\": \"Postman: температура превысила 30 °C\",\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"iot2_rule_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "04 Температура 20 — без уведомления",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_adapter}}/telemetry",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{iot2_device_id}},\n  \"data\": {\n    \"temperature\": 20\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(data.rules_evaluated).to.eql(true));",
                  "pm.test(\"Создано уведомлений: 0\", () => pm.expect(data.notifications_created).to.eql(0));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "05 Температура 35 — уведомление",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_adapter}}/telemetry",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{iot2_device_id}},\n  \"data\": {\n    \"temperature\": 35\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(data.rules_evaluated).to.eql(true));",
                  "pm.test(\"Создано уведомлений: 1\", () => pm.expect(data.notifications_created).to.eql(1));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "06 Температура 36 — без дубля",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{iot2_adapter}}/telemetry",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{iot2_device_id}},\n  \"data\": {\n    \"temperature\": 36\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(data.rules_evaluated).to.eql(true));",
                  "pm.test(\"Создано уведомлений: 0\", () => pm.expect(data.notifications_created).to.eql(0));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "07 Получить устройство и телеметрию",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/devices/{{iot2_device_id}}",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Телеметрия сохранена\", () => pm.expect(pm.response.json().telemetry.length).to.be.at.least(3));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "08 Получить правила устройства",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/devices/{{iot2_device_id}}/rules",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Правило найдено\", () => pm.expect(pm.response.json().some(r => String(r.id) === String(pm.collectionVariables.get(\"iot2_rule_id\")))).to.eql(true));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "09 Получить уведомления пользователя",
