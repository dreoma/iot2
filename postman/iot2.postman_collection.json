                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/users/{{iot2_user_id}}/notifications",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Одно срабатывание правила\", () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "10 Получить пользователя с устройствами",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{iot2_token}}"
              }
            ],
            "url": "{{iot2_core}}/users/{{iot2_user_id}}",
            "description": "Локальная проверка iot2. Только синтетические тестовые данные."
