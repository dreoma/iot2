{
  "info": {
    "name": "IoT2 — уведомления Email + Telegram",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Заполните Variables: notify_mail и notify_password. Для нового аккаунта выполните папку регистрации и подтвердите Telegram по ссылке из ответа. Затем выполните папку 01. Правила отправляют сообщения на привязанный Telegram и почту. По умолчанию почта попадает в Mailpit. SSL verification отключена для локальных HTTPS-запросов."
  },
  "variable": [
    {
      "key": "notify_mail",
      "value": "",
      "description": "Ваша почта — заполнить вручную"
    },
    {
      "key": "notify_core",
      "value": "https://localhost:8443"
    },
    {
      "key": "notify_adapter",
      "value": "http://localhost:8081"
    },
    {
      "key": "notify_user_id",
      "value": ""
    },
    {
      "key": "notify_device_id",
      "value": ""
    },
    {
      "key": "notify_rule_id",
      "value": ""
    },
    {
      "key": "notify_password",
      "value": "",
      "description": "Пароль учётной записи, заполните локально"
    },
    {
      "key": "notify_token",
      "value": ""
    },
    {
      "key": "notify_registration_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const mail = String(pm.collectionVariables.get(\"notify_mail\") || \"\").trim();",
          "if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(mail)) throw new Error(\"Заполните notify_mail во вкладке Variables коллекции\");",
          "const password = String(pm.collectionVariables.get(\"notify_password\") || \"\");",
          "if (!password) throw new Error(\"Заполните notify_password во вкладке Variables коллекции\");",
          "pm.variables.set(\"notify_password_json\", JSON.stringify(password));",
          "pm.variables.set(\"notify_mail_json\", JSON.stringify(mail));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Проверка Email + Telegram — по порядку",
      "item": [
        {
          "name": "Войти и сохранить токен",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_core}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": {{notify_mail_json}},\n  \"password\": {{notify_password_json}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const session = pm.response.json();",
                  "    pm.collectionVariables.set(\"notify_token\", session.token);",
                  "    pm.collectionVariables.set(\"notify_user_id\", session.user_id);",
                  "} else {",
                  "    pm.collectionVariables.unset(\"notify_token\");",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "01 Проверить контакты своей учётной записи",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notify_token}}"
              }
            ],
            "url": "{{notify_core}}/users/{{notify_user_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Контакты совпадают\", () => {",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.mail).to.equal(pm.collectionVariables.get(\"notify_mail\"));",
                  "    pm.expect(Number.isSafeInteger(user.telegram_id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "02 Создать устройство с уведомлениями",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{notify_token}}"
              }
            ],
            "url": "{{notify_core}}/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Проверка уведомлений Postman\",\n  \"notifications_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"notify_device_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Создать правило temperature > 30",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{notify_token}}"
              }
            ],
            "url": "{{notify_core}}/rules",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"field\": \"temperature\",\n  \"operator\": \"gt\",\n  \"threshold\": 30,\n  \"message\": \"Проверка уведомлений: температура превысила 30 °C\",\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"notify_rule_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Температура 20 — исходное значение",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_adapter}}/telemetry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"data\": {\"temperature\": 20}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(r.rules_evaluated).to.eql(true));",
                  "pm.test(\"Срабатываний: 0\", () => pm.expect(r.notifications_created).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Температура 35 — отправить Email и Telegram",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_adapter}}/telemetry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"data\": {\"temperature\": 35}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(r.rules_evaluated).to.eql(true));",
                  "pm.test(\"Срабатываний: 1\", () => pm.expect(r.notifications_created).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Проверить историю срабатываний — не статус доставки",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notify_token}}"
              }
            ],
            "url": "{{notify_core}}/users/{{notify_user_id}}/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().filter(n => String(n.rule_id) === String(pm.collectionVariables.get(\"notify_rule_id\")));",
                  "pm.test(\"Наше правило сработало\", () => pm.expect(rows.length).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Температура 36 — убедиться, что нет дубля",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_adapter}}/telemetry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"data\": {\"temperature\": 36}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(r.rules_evaluated).to.eql(true));",
                  "pm.test(\"Срабатываний: 0\", () => pm.expect(r.notifications_created).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Посмотреть устройство и телеметрию",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notify_token}}"
              }
            ],
            "url": "{{notify_core}}/devices/{{notify_device_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Повторная отправка — сначала 25, затем 40",
      "item": [
        {
          "name": "25 °C — не создавать уведомление",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_adapter}}/telemetry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"data\": {\"temperature\": 25}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(r.rules_evaluated).to.eql(true));",
                  "pm.test(\"Срабатываний: 0\", () => pm.expect(r.notifications_created).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "40 °C — создать уведомление в оба канала",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_adapter}}/telemetry",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{notify_device_id}},\n  \"data\": {\"temperature\": 40}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Правила проверены\", () => pm.expect(r.rules_evaluated).to.eql(true));",
                  "pm.test(\"Срабатываний: 1\", () => pm.expect(r.notifications_created).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Локальная почта Mailpit",
      "item": [
        {
          "name": "Письма Mailpit — реальные SMTP письма видны только при внешнем SMTP",
          "protocolProfileBehavior": {
            "strictSSL": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8025/api/v1/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Регистрация новой учётной записи",
      "item": [
        {
          "name": "01 Ввести почту и получить ссылку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_core}}/auth/register/start",
            "description": "После ответа откройте значение telegram_url в Telegram и нажмите «Старт».",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": {{notify_mail_json}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"notify_registration_token\", pm.response.json().registration_token);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "02 Проверить подтверждение Telegram",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notify_registration_token}}"
              }
            ],
            "url": "{{notify_core}}/auth/register/status",
            "description": "Выполните после нажатия «Старт» в личном чате. Дождитесь telegram_confirmed: true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Telegram подтверждён\", () => pm.expect(pm.response.json().telegram_confirmed).to.be.true);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        },
        {
          "name": "03 Задать пароль",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notify_registration_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{notify_core}}/users",
            "description": "Завершите регистрацию до истечения срока ссылки.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": {{notify_password_json}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"notify_user_id\", pm.response.json().id);",
                  "  pm.collectionVariables.unset(\"notify_registration_token\");",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "strictSSL": false
          }
        }
      ]
    }
  ]
}
