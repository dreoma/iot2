build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.dSYM/
/iot-core/iot-core
/http-adapter/http-adapter

# Зависимости при ручной сборке
/.deps/
/_deps/

# Логи, временные файлы и Python-кэш тестов
*.log
*.tmp
*.swp
*.swo
*~
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

