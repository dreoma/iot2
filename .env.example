# Создайте ключ: openssl rand -hex 32
TRAFFIC_KEY_HEX=replace_with_64_hex_characters

# Отдельный секрет для хеширования паролей. Создайте через openssl rand -hex 32.
IOT_PASSWORD_PEPPER_HEX=

# TgBot: пустой токен отключает Telegram. Получить у BotFather.
IOT_TELEGRAM_BOT_TOKEN=
# Локальная почта попадает в Mailpit: http://localhost:8025
IOT_SMTP_URL=smtp://mailpit:1025
IOT_SMTP_USER=
IOT_SMTP_PASSWORD=
IOT_SMTP_FROM=iot@example.com
